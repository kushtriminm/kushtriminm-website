"use client";

import { useRef, useState, useSyncExternalStore } from "react";
import Image from "next/image";
import {
  Check,
  MessageCircle,
  X,
  Calendar as CalendarIcon,
  Users,
  MapPin,
  ChevronDown,
} from "lucide-react";
import {
  busTours,
  type BusTour,
  type Departure,
  type TourText,
} from "@/data/bus-tours";

type Lang = "sq" | "en";
type Tab = "program" | "includes" | "info";
type UpcomingTour = BusTour & { upcoming: Departure[] };

// All the words of this section, in both languages. Change them here.
const labels = {
  sq: {
    eyebrow: "Nisjet e radhës",
    heading: "Udhëtime me guidë",
    intro: "Transporti, hoteli dhe mëngjesi janë të rregulluar. Zgjidh datën dhe rezervo vendin.",
    from: "nga",
    perPerson: "për person",
    departures: "Nisjet",
    departure: "Nisja",
    details: "Detaje",
    book: "Rezervo",
    bookWhatsApp: "Rezervo në WhatsApp",
    close: "Mbyll",
    dates: "Zgjidh datën e nisjes",
    tabProgram: "Programi",
    tabIncludes: "Përfshihet",
    tabInfo: "Info",
    extras: "Pagesa në udhëtim",
    documents: "Dokumentet",
    departFrom: "Nisja nga qyteti",
    passengers: "Numri i personave",
    totalPrice: "Çmimi total:",
    hour: "Ora",
    leavesAt: "Nisja në orën",
    location: "Lokacioni",
    language: "Gjuha",
  },
  en: {
    eyebrow: "Upcoming departures",
    heading: "Guided tours",
    intro: "Transport, hotel and breakfast are arranged. Pick a date and reserve your seat.",
    from: "from",
    perPerson: "per person",
    departures: "Departures",
    departure: "Departure",
    details: "Details",
    book: "Book",
    bookWhatsApp: "Book on WhatsApp",
    close: "Close",
    dates: "Choose your departure date",
    tabProgram: "Program",
    tabIncludes: "Included",
    tabInfo: "Info",
    extras: "Payments during the trip",
    documents: "Documents",
    departFrom: "Departure city",
    passengers: "Number of passengers",
    totalPrice: "Total price:",
    hour: "At",
    leavesAt: "Departure at",
    location: "Location",
    language: "Language",
  },
};

function getToday() {
  const d = new Date();
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

const subscribe = () => () => {};

function euro(n: number) {
  return `${n}€`;
}

function dayMonth(date: string) {
  return date.split("-").reverse().slice(0, 2).join(".");
}

function fullDate(date: string) {
  return date.split("-").reverse().join("-");
}

function whatsappLink(text: string) {
  return `https://wa.me/38349833888?text=${encodeURIComponent(text)}`;
}

function priceInfo(tour: UpcomingTour) {
  const prices = tour.upcoming.map((d) => d.price ?? tour.price);
  return { min: Math.min(...prices), varies: new Set(prices).size > 1 };
}

// Departure cities, in order of time.
const departureCities = [
  { name: "Gjakovë", time: "14:00", location: "Stacioni i autobusve", locationEn: "Bus station" },
  { name: "Prizren", time: "15:00", location: "Stacioni i autobusve", locationEn: "Bus station" },
  { name: "Pejë", time: "15:00", location: "Stacioni i autobusve", locationEn: "Bus station" },
  { name: "Mitrovicë", time: "15:00", location: "Stacioni i autobusve", locationEn: "Bus station" },
  { name: "Suharekë", time: "15:15", location: "Reshtan, Parkingu i Autobanit", locationEn: "Reshtan, motorway parking" },
  { name: "Klinë", time: "15:20", location: "Te Nora Market", locationEn: "At Nora Market" },
  { name: "Malishevë", time: "15:20", location: "Te parkingu i autostradës, te rrethi i banjës", locationEn: "At the motorway parking, by the spa roundabout" },
  { name: "Kiçevë / Kievi", time: "15:30", location: "Stacioni i vjetër", locationEn: "Old station" },
  { name: "Vushtrri", time: "15:30", location: "Tek rrethi i Gojbules", locationEn: "At the Gojbulja roundabout" },
  { name: "Arllat", time: "15:40", location: "Në rrugën kryesore", locationEn: "On the main road" },
  { name: "Komoran", time: "15:50", location: "Tek udhëkryqi", locationEn: "At the junction" },
  { name: "Viti", time: "16:40", location: "Te udhëkryqi i Kllokotit", locationEn: "At the Kllokot junction" },
  { name: "Prishtinë", time: "17:00", location: "Stacioni i autobusve", locationEn: "Bus station" },
  { name: "Ferizaj", time: "17:30", location: "Te parkingu te autobani (Bibaj)", locationEn: "At the motorway parking (Bibaj)" },
  { name: "Hani i Elezit", time: "17:50", location: "Pumpa Shell në kufi", locationEn: "Shell petrol station at the border" },
];

function getCityTime(tourSlug: string | undefined, cityName: string, defaultTime: string) {
  if (tourSlug === "budapest-vienna" && cityName === "Prishtinë") {
    return "23:00";
  }
  return defaultTime;
}

export default function BusTours() {
  const today = useSyncExternalStore(subscribe, getToday, getToday);
  const dialogRef = useRef<HTMLDialogElement>(null);
  const [lang, setLang] = useState<Lang>("sq");
  const [selectedSlug, setSelectedSlug] = useState<string | null>(null);
  const [tab, setTab] = useState<Tab>("program");

  const [selectedDate, setSelectedDate] = useState<string | null>(null);
  const [selectedCity, setSelectedCity] = useState<string>(departureCities[0].name);
  const [isDropdownOpen, setIsDropdownOpen] = useState<boolean>(false);
  const [passengers, setPassengers] = useState<number>(1);

  const t = labels[lang];
  const pick = (tour: BusTour): TourText => (lang === "en" && tour.en ? tour.en : tour);

  const tours: UpcomingTour[] = busTours
    .filter((tour) => tour.active)
    .map((tour) => ({
      ...tour,
      upcoming: tour.departures
        .filter((d) => d.start >= today)
        .sort((a, b) => a.start.localeCompare(b.start)),
    }))
    .filter((tour) => tour.upcoming.length > 0);

  const selected = tours.find((tour) => tour.slug === selectedSlug) ?? null;
  const selectedText = selected ? pick(selected) : null;

  const allowedCities = selected
    ? departureCities.filter((c) => selected.from.includes(c.name))
    : departureCities;

  const activeDeparture = selected?.upcoming.find((d) => d.start === selectedDate);
  const unitPrice = activeDeparture?.price ?? selected?.price ?? 0;
  const totalPrice = unitPrice * passengers;

  function openDetails(slug: string) {
    setSelectedSlug(slug);
    setTab("program");
    const found = tours.find((tour) => tour.slug === slug);
    if (found) {
      if (found.upcoming.length > 0) {
        setSelectedDate(found.upcoming[0].start);
      }
      const initialCities = departureCities.filter((c) => found.from.includes(c.name));
      setSelectedCity(initialCities.length > 0 ? initialCities[0].name : departureCities[0].name);
    }
    setPassengers(1);
    setIsDropdownOpen(false);
    dialogRef.current?.showModal();
  }

  // When no departure is left, the whole section disappears.
  if (tours.length === 0) return null;

  const tabs: { id: Tab; label: string }[] = [
    { id: "program", label: t.tabProgram },
    { id: "includes", label: t.tabIncludes },
    { id: "info", label: t.tabInfo },
  ];

  const cityObj = departureCities.find((c) => c.name === selectedCity);
  const displayTime = cityObj ? getCityTime(selected?.slug, cityObj.name, cityObj.time) : "";

  let whatsappMessage = "";
  if (selected && selectedText && selectedDate) {
    whatsappMessage =
      lang === "en"
        ? `Hello! I would like to book the ${selectedText.title} trip (${selectedText.frequency}, departure: ${fullDate(selectedDate)}) from ${selectedCity} (${displayTime}), for ${passengers} person(s). Total price: ${totalPrice}€.`
        : `Përshëndetje! Dua të rezervoj udhëtimin për ${selectedText.title} (${selectedText.frequency}, Nisja: ${fullDate(selectedDate)}), nga qyteti: ${selectedCity} (${displayTime}), për ${passengers} person/a. Çmimi total: ${totalPrice}€.`;
  }

  return (
    <section
      lang={lang}
      className="bg-gradient-to-b from-black via-neutral-950 to-black px-5 py-10 sm:py-16"
    >
      <div className="mx-auto max-w-5xl">
        <div className="text-center">
          <p className="text-xs font-bold uppercase text-red-500 sm:text-sm">{t.eyebrow}</p>
          <h2 className="mt-2 text-2xl font-extrabold uppercase tracking-wide text-white sm:text-4xl">
            {t.heading}
          </h2>
          <p className="mx-auto mt-3 max-w-md text-sm text-gray-400">{t.intro}</p>

          <div
            role="group"
            aria-label={t.language}
            className="mt-4 inline-flex rounded-full border border-white/15 bg-black/60 p-0.5 text-xs font-bold"
          >
            {(["sq", "en"] as Lang[]).map((l) => (
              <button
                key={l}
                type="button"
                aria-pressed={lang === l}
                onClick={() => setLang(l)}
                className={`min-w-[44px] rounded-full px-3 py-1.5 transition ${
                  lang === l ? "bg-red-600 text-white" : "text-gray-400 hover:text-white"
                }`}
              >
                {l.toUpperCase()}
              </button>
            ))}
          </div>
        </div>

        <div className="-mx-5 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 lg:grid-cols-3">
          {tours.map((tour) => {
            const info = priceInfo(tour);
            const text = pick(tour);

            return (
              <article
                key={tour.slug}
                className="flex w-[74%] shrink-0 snap-center flex-col overflow-hidden rounded-2xl border border-white/10 bg-neutral-900 transition duration-300 hover:border-red-500/60 hover:shadow-[0_0_30px_rgba(220,38,38,0.2)] sm:w-[60%] md:w-auto"
              >
                <div className="relative aspect-[16/10] w-full bg-gradient-to-br from-neutral-800 to-neutral-950">
                  {tour.image && (
                    <Image
                      src={tour.image}
                      alt={text.title}
                      fill
                      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 74vw"
                      className="object-cover"
                    />
                  )}
                  <span className="absolute left-2.5 top-2.5 rounded-full bg-black/60 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white backdrop-blur-sm">
                    {text.duration}
                  </span>
                </div>

                <div className="flex flex-1 flex-col p-4">
                  <h3 className="text-xl font-extrabold uppercase tracking-wide text-white">
                    {text.title}
                  </h3>

                  <p className="mt-1 flex items-baseline gap-1.5">
                    {info.varies && <span className="text-xs text-gray-400">{t.from}</span>}
                    <span className="text-3xl font-black text-red-500">{euro(info.min)}</span>
                    <span className="text-xs text-gray-400">{text.priceNote}</span>
                  </p>

                  <div className="mt-3 flex flex-wrap items-center gap-1.5">
                    <span className="rounded-full bg-red-600/20 px-2.5 py-1 text-[11px] font-bold text-red-400">
                      {t.departures}: {text.frequency}
                    </span>
                    {tour.upcoming.slice(0, 3).map((d) => (
                      <span
                        key={d.start}
                        className="rounded-full bg-black px-2 py-1 text-[11px] font-bold text-white"
                      >
                        {dayMonth(d.start)}
                      </span>
                    ))}
                    {tour.upcoming.length > 3 && (
                      <span className="text-[11px] text-gray-400">+{tour.upcoming.length - 3}</span>
                    )}
                  </div>

                  <ul className="mt-3 space-y-1 text-[13px] text-gray-200">
                    {text.highlights.map((item) => (
                      <li key={item} className="flex gap-2">
                        <Check size={14} className="mt-0.5 shrink-0 text-red-500" />
                        {item}
                      </li>
                    ))}
                  </ul>

                  <div className="mt-auto grid grid-cols-2 gap-2 pt-4">
                    <button
                      type="button"
                      onClick={() => openDetails(tour.slug)}
                      className="min-h-[44px] rounded-full border border-white/30 text-xs font-bold text-white transition hover:bg-white hover:text-black"
                    >
                      {t.details}
                    </button>
                    <button
                      type="button"
                      onClick={() => openDetails(tour.slug)}
                      className="flex min-h-[44px] items-center justify-center gap-1.5 rounded-full bg-red-600 text-xs font-bold text-white transition hover:bg-red-700"
                    >
                      <MessageCircle size={14} />
                      {t.book}
                    </button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <dialog
        ref={dialogRef}
        aria-label={selectedText?.title ?? t.details}
        onClose={() => {
          document.body.style.overflow = "";
        }}
        onClick={(e) => {
          if (e.target === dialogRef.current) dialogRef.current?.close();
        }}
        className="fixed inset-0 m-auto h-fit max-h-[88svh] w-[calc(100%-1.5rem)] max-w-lg overflow-y-auto overscroll-contain rounded-3xl bg-neutral-900 p-0 text-white backdrop:bg-black/70"
      >
        {selected && selectedText && (
          <div>
            <div className="relative">
              {selected.image && (
                <div className="relative aspect-[16/6] w-full">
                  <Image
                    src={selected.image}
                    alt={selectedText.title}
                    fill
                    sizes="(min-width: 640px) 512px, 100vw"
                    className="object-cover"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-neutral-900 to-transparent" />
                </div>
              )}

              <button
                type="button"
                aria-label={t.close}
                onClick={() => dialogRef.current?.close()}
                className="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/60 backdrop-blur-sm transition hover:bg-black"
              >
                <X size={18} />
              </button>

              <div className="px-5 pb-1 pr-14 pt-4">
                <span className="mb-1 inline-block rounded-full bg-red-600/20 px-3 py-0.5 text-xs font-bold text-red-400">
                  {selectedText.duration} • {selectedText.frequency}
                </span>
                <h3 className="text-xl font-extrabold uppercase tracking-wide">
                  {selectedText.title}
                </h3>
                <p className="mt-1 flex items-baseline gap-2">
                  <span className="text-2xl font-black text-red-500">{euro(unitPrice)}</span>
                  <span className="text-sm text-gray-400">{selectedText.priceNote}</span>
                </p>
              </div>
            </div>

            <div className="px-5 pb-5">
              <div className="mt-4">
                <p className="flex items-center gap-1.5 text-xs font-bold uppercase text-gray-400">
                  <CalendarIcon size={14} className="text-red-500" />
                  {t.dates}
                </p>
                <div className="mt-2 flex snap-x snap-mandatory gap-2 overflow-x-auto pb-2 sm:grid sm:grid-cols-4 sm:overflow-visible [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                  {selected.upcoming.map((d) => {
                    const isSelected = selectedDate === d.start;
                    return (
                      <button
                        key={d.start}
                        type="button"
                        aria-pressed={isSelected}
                        onClick={() => setSelectedDate(d.start)}
                        className={`flex min-h-[48px] min-w-[84px] shrink-0 snap-center flex-col items-center justify-center rounded-xl border p-2 text-xs font-bold transition ${
                          isSelected
                            ? "border-red-500 bg-red-600 text-white shadow-lg shadow-red-600/30"
                            : "border-white/10 bg-black/60 text-gray-200 hover:border-red-500/50"
                        }`}
                      >
                        <span className="text-[10px] uppercase opacity-75">{t.departure}</span>
                        <span className="mt-0.5 text-sm font-extrabold">{dayMonth(d.start)}</span>
                      </button>
                    );
                  })}
                </div>
              </div>

              <div className="relative mt-4">
                <label className="mb-2 flex items-center gap-1.5 text-xs font-bold uppercase text-gray-400">
                  <MapPin size={14} className="text-red-500" />
                  {t.departFrom}
                </label>

                <div className="relative">
                  <button
                    type="button"
                    aria-expanded={isDropdownOpen}
                    onClick={() => setIsDropdownOpen(!isDropdownOpen)}
                    className="flex min-h-[48px] w-full items-center justify-between rounded-2xl border border-white/10 bg-black px-4 py-3 text-sm font-medium text-white outline-none transition focus:border-red-500"
                  >
                    <span>
                      {selectedCity} — {t.hour} {displayTime}
                    </span>
                    <ChevronDown
                      size={16}
                      className={`text-gray-400 transition-transform ${isDropdownOpen ? "rotate-180" : ""}`}
                    />
                  </button>

                  {isDropdownOpen && (
                    <div className="absolute left-0 right-0 top-full z-20 mt-2 max-h-56 space-y-1 overflow-y-auto rounded-2xl border border-white/10 bg-neutral-950 p-2 shadow-2xl">
                      {allowedCities.map((city) => {
                        const cTime = getCityTime(selected.slug, city.name, city.time);
                        const isChosen = selectedCity === city.name;
                        return (
                          <button
                            key={city.name}
                            type="button"
                            onClick={() => {
                              setSelectedCity(city.name);
                              setIsDropdownOpen(false);
                            }}
                            className={`flex min-h-[44px] w-full items-center justify-between rounded-xl px-3 py-2 text-left text-xs transition ${
                              isChosen
                                ? "bg-red-600 font-bold text-white"
                                : "text-gray-300 hover:bg-neutral-800 hover:text-white"
                            }`}
                          >
                            <span>{city.name}</span>
                            <span className="opacity-80">
                              {t.hour} {cTime}
                            </span>
                          </button>
                        );
                      })}
                    </div>
                  )}
                </div>

                {cityObj && (
                  <p className="mt-2 flex flex-col gap-0.5 pl-1 text-xs text-gray-400">
                    <span>
                      {t.leavesAt} <strong className="text-white">{displayTime}</strong>
                    </span>
                    <span>
                      {t.location}:{" "}
                      <span className="text-gray-300">
                        {lang === "en" ? cityObj.locationEn : cityObj.location}
                      </span>
                    </span>
                  </p>
                )}
              </div>

              <div className="mt-4 flex items-center justify-between rounded-2xl border border-white/10 bg-black/40 px-4 py-3">
                <div className="flex items-center gap-2">
                  <Users size={16} className="text-red-500" />
                  <span className="text-xs font-bold uppercase text-gray-300">{t.passengers}</span>
                </div>
                <div className="flex items-center gap-3">
                  <button
                    type="button"
                    aria-label="-"
                    onClick={() => setPassengers(Math.max(1, passengers - 1))}
                    className="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-800 text-base font-bold text-white transition hover:bg-red-600"
                  >
                    -
                  </button>
                  <span className="w-6 text-center text-base font-extrabold text-white">
                    {passengers}
                  </span>
                  <button
                    type="button"
                    aria-label="+"
                    onClick={() => setPassengers(passengers + 1)}
                    className="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-800 text-base font-bold text-white transition hover:bg-red-600"
                  >
                    +
                  </button>
                </div>
              </div>

              <div className="mt-3 flex items-center justify-between rounded-2xl border border-red-600/30 bg-red-600/10 px-4 py-3">
                <span className="text-sm font-bold text-gray-300">{t.totalPrice}</span>
                <span className="text-2xl font-black text-red-500">{euro(totalPrice)}</span>
              </div>

              <div className="mt-4 grid grid-cols-3 gap-1 rounded-full bg-black/60 p-1 text-xs font-bold">
                {tabs.map((tabItem) => (
                  <button
                    key={tabItem.id}
                    type="button"
                    aria-pressed={tab === tabItem.id}
                    onClick={() => setTab(tabItem.id)}
                    className={`min-h-[40px] rounded-full transition ${
                      tab === tabItem.id ? "bg-red-600 text-white" : "text-gray-400 hover:text-white"
                    }`}
                  >
                    {tabItem.label}
                  </button>
                ))}
              </div>

              <div className="mt-4 text-sm leading-6 text-gray-300">
                {tab === "program" && (
                  <ol className="space-y-4">
                    {selectedText.itinerary.map((step) => (
                      <li key={step.day} className="border-l-2 border-red-600 pl-4">
                        <p className="font-bold text-white">{step.day}</p>
                        <p>{step.text}</p>
                      </li>
                    ))}
                  </ol>
                )}

                {tab === "includes" && (
                  <ul className="space-y-2">
                    {selectedText.includes.map((item) => (
                      <li key={item} className="flex gap-2">
                        <Check size={16} className="mt-1 shrink-0 text-red-500" />
                        {item}
                      </li>
                    ))}
                  </ul>
                )}

                {tab === "info" && (
                  <div className="space-y-5">
                    <div>
                      <p className="font-bold text-white">{t.extras}</p>
                      <ul className="mt-1 space-y-1">
                        {selectedText.extras.map((extra) => (
                          <li key={extra}>{extra}</li>
                        ))}
                      </ul>
                    </div>
                    <p>
                      <span className="font-bold text-white">{t.documents}: </span>
                      {selectedText.documents}
                    </p>
                  </div>
                )}
              </div>
            </div>

            <div className="sticky bottom-0 border-t border-neutral-800 bg-neutral-900 p-4">
              <a
                href={whatsappLink(whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                className="flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-red-600 py-3 font-bold text-white shadow-lg shadow-red-600/30 transition hover:bg-red-700"
              >
                <MessageCircle size={18} />
                {t.bookWhatsApp}
              </a>
            </div>
          </div>
        )}
      </dialog>
    </section>
  );
}